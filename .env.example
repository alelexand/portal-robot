# Copy this file to .env and fill it in. .env is ignored by git: never commit real credentials.
PORTAL_URL=http://127.0.0.1:5000
PORTAL_USER=demo
PORTAL_PASSWORD=demo123

# Optional
HEADLESS=true
# Empty uses Playwright's Chromium; "msedge" or "chrome" use the browser installed on the machine.
BROWSER_CHANNEL=
SLOW_MO_MS=0
TIMEOUT_MS=15000
RETRIES=3
